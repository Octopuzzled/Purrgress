# Copy to .env.deploy and adjust.
# .env.deploy is not committed to the Git repository (see .gitignore).

# SSH target: user@server, exactly how you log in via ssh
DEPLOY_HOST=user@your-server

# Folder on the server that Caddy serves the app from
DEPLOY_PATH=/var/www/purrgress

# Folder for the sync server (PocketBase), relative to your home directory on the server
SERVER_PATH=docker/purrgress-api
