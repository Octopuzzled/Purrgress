# Kopieren nach .env.deploy und anpassen.
# .env.deploy landet nicht im Git-Repo (siehe .gitignore).

# SSH-Ziel: Benutzer@Server – genau so, wie du dich per ssh anmeldest
DEPLOY_HOST=benutzer@dein-server

# Ordner auf dem Server, aus dem Caddy die App ausliefert
DEPLOY_PATH=/var/www/purrgress

# Ordner für den Sync-Server (PocketBase) – relativ zu deinem Home-Verzeichnis auf dem Server
SERVER_PATH=docker/purrgress-api
